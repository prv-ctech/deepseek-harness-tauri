# Existing user-defined Docker bridge shared with the reverse proxy.
PROXY_NETWORK=dsh-proxy

# Keep this value unchanged after setup; Compose uses it to name persistent volumes.
COMPOSE_PROJECT_NAME=deepseek-harness

# Optional Intel GPU override only; get the numeric host render group ID.
# RENDER_GID=...

# Selkies runs as fixed UID/GID 1000:1000; PUID/PGID do not remap it.
